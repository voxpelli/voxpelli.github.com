{
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "build": "domstack --copy images --copy media && sed \"s/__BUILD_VERSION__/$(git rev-parse --short HEAD)/\" sw.js > public/sw.js && cp public/404/index.html public/404.html",
    "dev": "mkdir -p public && cp sw.js public/sw.js && domstack --watch --copy images --copy media",
    "build:drafts": "domstack --drafts --copy images --copy media",
    "check:lint": "eslint --report-unused-disable-directives .",
    "check:tsc": "tsc",
    "check:type-coverage": "type-coverage --detail --strict --at-least 95 --ignore-files 'sw.js'",
    "check": "run-p check:* --continue-on-error",
    "test:build": "node --test 'test/**/*.spec.js'",
    "test": "run-s check build test:build",
    "husky-enable": "husky",
    "husky-disable": "git config --unset core.hooksPath",
    "prepare": "husky"
  },
  "devDependencies": {
    "@domstack/static": "^11",
    "@types/node": "^20.19.0",
    "@voxpelli/eslint-config": "^23",
    "@voxpelli/tsconfig": "^16",
    "eslint": "^9",
    "husky": "^9",
    "npm-run-all2": "^8",
    "type-coverage": "^2.29.7",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "async-htm-to-string": "^5.0.2"
  }
}
