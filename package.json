{
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "build": "domstack --copy images --copy media --copy static",
    "dev": "domstack --watch --copy images --copy media --copy static",
    "build:drafts": "domstack --drafts --copy images --copy media --copy static",
    "check:lint": "eslint --report-unused-disable-directives .",
    "check:tsc": "tsc",
    "check": "run-p check:* --continue-on-error",
    "test": "run-s check",
    "husky-enable": "husky",
    "husky-disable": "git config --unset core.hooksPath",
    "prepare": "husky"
  },
  "devDependencies": {
    "@domstack/static": "^11",
    "@types/node": "^20.19.0",
    "@voxpelli/eslint-config": "^23",
    "@voxpelli/tsconfig": "^16",
    "eslint": "^9",
    "gray-matter": "^4.0.3",
    "husky": "^9",
    "npm-run-all2": "^8",
    "typescript": "~5.9.3"
  }
}
